# PostgreSQL connection string (Supabase, Neon, AWS RDS, or local PostgreSQL)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Secret key for JWT signature and cookie auth
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Backend REST API Server port (default: 5000)
PORT=5000

# Node environment
NODE_ENV=production
